# Copy this file to .env and fill in your values.
# Never commit .env with real secrets.

# ── Platform: Telegram (required for Telegram bot mode) ───────────────

TELEGRAM_BOT_TOKEN=
# Get this from @BotFather on Telegram: /newbot
# If unset, Telegram interface is disabled.

# ── Platform: API (optional — REST API server) ───────────────────────

# API_HOST=0.0.0.0
# API_PORT=5000
# API_DEBUG=false
# The API server provides POST /api/chat for programmatic access.
# Authentication: pass X-API-Key header or ?api_key= query param.

# ── Platform: Discord (optional) ───────────────────────────────────

# DISCORD_BOT_TOKEN=
# Get this from https://discord.com/developers/applications
# Requires discord.py: pip install discord.py
# Enable Message Content Intent in Discord Developer Portal.
# If unset, Discord interface is disabled.

# DISCORD_OWNER_ID=
# Your Discord user ID (18-digit snowflake — NOT your Telegram user ID).
# To find it: Discord Settings → Advanced → enable Developer Mode,
# then right-click your username anywhere → Copy User ID.
# If unset, falls back to OWNER_USER_ID (only useful if you happen to
# use the same numeric ID on both platforms, which is never the case).

# ── Required (all modes) ─────────────────────────────────────────────

BOT_ENCRYPTION_KEY=
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# CRITICAL: back this up separately. If lost, all stored API keys become
# unrecoverable and must be re-added.

# ── Security — strongly recommended ──────────────────────────────────────────

OWNER_USER_ID=
# Your Telegram user ID. Message @userinfobot to find it.
# If left empty, the bot responds to ALL Telegram users — only safe for
# local development or testing on a private network.

# ── Optional ──────────────────────────────────────────────────────────────────

DATABASE_PATH=./data/rk.db

AGENT_NAME=rika
# Purely cosmetic — the project name stays rika-agent.

# ── Provider keys ─────────────────────────────────────────────────────────────
# All optional here — can also be added later via /addkey in Telegram.

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

NVIDIA_API_KEY=
# Format: nvapi-...
# Auto-enables NVIDIA NIM when set (50+ models via integrate.api.nvidia.com)

VERCEL_API_KEY=
VERCEL=1
# Both required together to auto-enable the Vercel AI Gateway provider.

# ── Optional: Postgres backend ───────────────────────────────────────────────
# SQLite is used by default. Set this to switch to Postgres.
# Requires: pip install asyncpg

POSTGRES_URL=
# Format: postgresql://user:pass@host:5432/dbname

# ── Optional: Vercel KV / Upstash Redis ──────────────────────────────────────
# Used for session caching. Auto-disabled when unset.

KV_REST_API_URL=
KV_REST_API_TOKEN=
